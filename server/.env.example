# FluxFinance Server Environment Variables
# Copy this file to .env and fill in your values

# Tink API Credentials (Get from https://console.tink.com)
TINK_CLIENT_ID=your_tink_client_id_here
TINK_CLIENT_SECRET=your_tink_client_secret_here

# Tink API URL (Default: production)
TINK_API_URL=https://api.tink.com

# OAuth Callback URL (must match Tink console settings)
TINK_REDIRECT_URI=http://localhost:3001/api/tink/callback

# Frontend URL for redirects after authentication
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=3001
NODE_ENV=development
